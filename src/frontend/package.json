{
	"name": "svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test": "vitest",
		"test:ci": "vitest run",
		"build-ts": "NODE_OPTIONS=--experimental-strip-types npm run build",
